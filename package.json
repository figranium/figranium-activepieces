    "@activepieces/pieces-common": "latest",
    "@activepieces/pieces-framework": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0"
  }
